# Retrieval / env overrides
CRAG_RETRIEVAL_MODE=hybrid
CRAG_TOP_K=5
CRAG_CANDIDATE_K=20
CRAG_DENSE_SEARCH=python

# API
CRAG_API_HOST=127.0.0.1
CRAG_API_PORT=8000
# When set, /v1/index|/v1/retrieve|/v1/context require Bearer or X-API-Key
CRAG_API_KEY=
# Path-separated list restricting which directories /v1/index may read
CRAG_ALLOWED_INDEX_ROOTS=

# Unstructured API (PDF parsing)
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_PDF_STRATEGY=hi_res
UNSTRUCTURED_VLM_MODEL=gpt-4o
UNSTRUCTURED_VLM_PROVIDER=openai

# Embeddings
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64

# Storage
CRAG_STORAGE_PATH=workspace_index/crag.sqlite3
CRAG_COLLECTION=default

# Context pack
CRAG_CONTEXT_MAX_CHARS=4000
